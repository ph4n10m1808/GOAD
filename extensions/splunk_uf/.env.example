# Copy this file to .env, change the password, then export it before starting GOAD.
GOAD_SPLUNK_INDEXER_HOST=192.168.58.10
GOAD_SPLUNK_INDEXER_SCHEME=https
GOAD_SPLUNK_INDEXER_API_PORT=8089
GOAD_SPLUNK_INDEXER_USER=admin
GOAD_SPLUNK_INDEXER_PASSWORD=change-me
GOAD_SPLUNK_VERIFY_TLS=false

# The UF sends directly here. Defaults to INDEXER_HOST and port 9997.
GOAD_SPLUNK_RECEIVER_HOST=192.168.58.10
GOAD_SPLUNK_RECEIVER_PORT=9997
GOAD_SPLUNK_WINDOWS_INDEX=wineventlog
GOAD_SPLUNK_WEB_INDEX=web

# Optional policy. Bootstrap is enabled automatically when PASSWORD is set.
GOAD_SPLUNK_AUTO_CONFIGURE_INDEXER=true
GOAD_SPLUNK_INDEXER_REQUIRED=false
GOAD_SPLUNK_RETENTION_SECONDS=2592000
GOAD_SPLUNK_MAX_INDEX_SIZE_MB=500000
